<%- include('../partials/header') %>

    <h1>
        <%= title %>
    </h1>

    <div id="filters">
        <div class="search-group">
            <label for="trip-search">Search trips:</label>
            <input type="search" id="trip-search" placeholder="Search by trip name or description..." maxlength="100">
        </div>

        <div class="filter-group">
            <label for="region-filter">Search by Region:</label>
            <select id="region-filter">
                <option value="">All Regions</option>
            </select>
        </div>

        <div class="filter-group">
            <label for="season-filter">Search by Season:</label>
            <select id="season-filter">
                <option value="">Any Season</option>
            </select>
        </div>

        <button type="button" id="clear-filters">
            Clear Filters
        </button>
    </div>

    <div id="trips-status" role="status" aria-live="polite">
        Loading trips...
    </div>

    <div class="routes-grid" id="trips-container"></div>

    <div id="pagination-controls" class="pagination-controls" aria-label="Trip list pagination"></div>

    <script src="/js/trips.js" defer></script>

    <%- include('../partials/footer') %>